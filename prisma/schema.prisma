generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// La marca/dueño completo. Puede tener una o varias sucursales (Business).
// Los clientes y su historial de sanciones viven aquí, no en la sucursal,
// para que se compartan entre todas las ubicaciones del mismo dueño.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  locations Business[]
  clients   Client[]
}

// Una sucursal/ubicación física: barbería, salón, spa, clínica, veterinaria,
// taller, gimnasio, etc. Cada una tiene su propio personal, servicios y
// horarios, y su propia página pública de reservas.
model Business {
  id                      String   @id @default(cuid())
  organizationId          String
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                    String
  slug                    String   @unique
  category                String   @default("BARBERSHOP") // BARBERSHOP, HAIR_SALON, SPA
  phone                   String?
  address                 String?
  plan                    String   @default("GRATIS") // GRATIS, PRO
  // Suscripción — controlada por Soporte, no por el dueño del negocio.
  subscriptionStatus      String   @default("ACTIVE") // ACTIVE, SUSPENDED
  subscriptionRenewsAt    DateTime? // próxima fecha de renovación/vencimiento; null = sin definir aún
  subscriptionNotes       String? // texto libre de soporte: método de pago, acuerdos, historial breve
  suspendedAt             DateTime?
  suspendedReason         String?
  cancellationNoticeHours Int      @default(3)
  reminderChannels        String   @default("") // CSV de EMAIL,SMS,WHATSAPP — "" = sin recordatorios; puede tener varios a la vez
  reminderHoursBefore     Int      @default(24)
  advancePaymentEnabled          Boolean  @default(false) // exige pago anticipado (transferencia/QR/Bre-B) para reservar en línea
  advancePaymentAmount           Float?   // null = cobra el precio completo del servicio; número = seña fija
  advancePaymentExpirationHours  Int      @default(2) // horas para confirmar el pago antes de liberar el horario
  paymentQrUrl                   String?
  paymentBrebKey                 String?
  paymentAccountInfo             String?  // texto libre: banco, tipo de cuenta, número, titular
  loyaltyEnabled          Boolean  @default(false)
  loyaltyPointsPerVisit   Int      @default(1)
  loyaltyRewardThreshold  Int      @default(10)
  referralBonusPoints    Int      @default(0) // 0 = programa de referidos desactivado
  onboardingDismissed    Boolean  @default(false)
  cashDiscrepancyAlertThreshold Float @default(5) // avisa por correo al dueño si el faltante/sobrante de una caja supera este monto
  lastDigestSentAt        DateTime? // evita mandar el resumen semanal dos veces si el cron se traslapa
  taxId                   String? // NIT o documento de identificación tributaria, para la factura
  nextReceiptNumber       Int      @default(1) // consecutivo de la próxima factura/recibo a emitir
  logoUrl                 String? // logo propio del negocio; se usa en sus facturas PDF en vez de solo texto
  storeEnabled            Boolean  @default(false) // "Tiendita" (mecatos/bebidas) — la activa Soporte, no todos los negocios la venden
  giftCardsEnabled        Boolean  @default(false) // Tarjetas de regalo — la activa Soporte, no todos los negocios las venden
  createdAt               DateTime @default(now())

  users        User[]
  staff        Staff[]
  services     Service[]
  products     Product[]
  appointments Appointment[]
  reviews      Review[]
  cashSessions   CashSession[]
  productSales   ProductSale[]
  storeItems     StoreItem[]
  storeSales     StoreSale[]
  storeRestocks  StoreRestock[]
  payrollPayouts PayrollPayout[]
  subscriptionInvoices SubscriptionInvoice[]
  waitlistEntries WaitlistEntry[]
  coupons         Coupon[]
  expenses        Expense[]
  servicePackages   ServicePackage[]
  packagePurchases  ClientPackagePurchase[]
  giftCards         GiftCard[]
}

// Historial de un cliente a nivel de organización: si canceló tarde o no
// llegó en una sucursal, se ve en todas las sucursales del mismo dueño.
model Client {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  phone          String
  email          String? // opcional, para recordatorios por correo
  strikes        Int      @default(0) // cancelaciones tardías + no-shows
  loyaltyPoints  Int      @default(0)
  marketingOptIn Boolean  @default(true) // recibe difusión masiva de WhatsApp; ya recibe recordatorios igual
  referralCode   String   @unique // código propio para compartir; se genera al crear el cliente
  referredById   String?
  referredBy     Client?  @relation("ClientReferrals", fields: [referredById], references: [id])
  referrals      Client[] @relation("ClientReferrals")
  createdAt      DateTime @default(now())

  appointments     Appointment[]
  reviews          Review[]
  packagePurchases ClientPackagePurchase[]

  @@unique([organizationId, phone])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("OWNER") // OWNER (ve/administra todas las sucursales) o STAFF (asignado a una sola)
  permissions  String   @default("") // CSV para cuentas STAFF: staff,catalog,reports,settings (Equipo y Sucursales son siempre exclusivas del dueño)
  active       Boolean  @default(true)
  businessId   String // sucursal "de origen"; el dueño puede cambiar de sucursal activa dentro de su sesión
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // A qué miembro del roster (Staff) corresponde esta cuenta de acceso, para
  // poder exigir que cada quien solo abra/cierre su propia caja. Null = la
  // cuenta no tiene un roster asociado (ej. el dueño, si no atiende clientes).
  staffId      String?  @unique
  linkedStaff  Staff?   @relation("UserStaffLink", fields: [staffId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  resetTokens    PasswordResetToken[]
  openedSessions CashSession[] @relation("CashSessionOpenedBy")
  closedSessions CashSession[] @relation("CashSessionClosedBy")
  productSales   ProductSale[]
  payrollPayouts PayrollPayout[]
  storeSales     StoreSale[]
  storeRestocks  StoreRestock[]
  giftCardsIssued GiftCard[]
  depositsConfirmed Appointment[] @relation("AppointmentDepositConfirmedBy")
  refundsProcessed  Appointment[] @relation("AppointmentRefundedBy")
  cashMovements     CashMovement[]
}

// Token de un solo uso para el flujo de "olvidé mi contraseña". Se guarda el hash,
// nunca el token en texto plano (igual que con las contraseñas).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Un miembro del personal (barbero, estilista, doctor, veterinario, entrenador, técnico...).
// El cliente puede elegirlo por nombre o dejar que el sistema asigne a quien tenga menos carga.
model Staff {
  id                String   @id @default(cuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  photoUrl          String?
  active            Boolean  @default(true)
  commissionPercent Int? // null = este negocio no maneja comisión por empleado
  workStart         String   @default("09:00") // HH:mm
  workEnd           String   @default("19:00") // HH:mm
  workDays          String   @default("1,2,3,4,5,6") // 0=domingo..6=sábado
  bufferMinutes     Int      @default(0) // minutos de limpieza/descanso después de cada cita
  monthlyRevenueGoal Float? // null = sin meta definida
  createdAt         DateTime @default(now())

  appointments    Appointment[]
  reviews         Review[]
  cashSessions    CashSession[]
  timeOff         StaffTimeOff[]
  payrollPayouts  PayrollPayout[]
  waitlistEntries WaitlistEntry[]
  linkedUser      User?           @relation("UserStaffLink")
}

// Rango de fechas en el que un miembro del personal no trabaja (vacaciones,
// incapacidad) — excepción puntual al horario semanal fijo de Staff.workDays.
model StaffTimeOff {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([staffId, startDate, endDate])
}

model Service {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  imageUrl        String?
  durationMinutes Int      @default(30)
  price           Float
  depositAmount   Float? // seña específica de este servicio; null = usa la seña general del negocio (o el precio completo)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]
  packages        ServicePackage[]
}

// Cupón de descuento — solo aplica a la reserva pública de citas (no a venta
// de productos ni a citas sin cita previa).
model Coupon {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code          String
  discountType  String // PERCENT, FIXED
  discountValue Float
  maxUses       Int?
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@unique([businessId, code])
}

// Gasto operativo (arriendo, insumos, servicios) para que Reportes/Analítica
// muestren ganancia real, no solo ingreso bruto.
model Expense {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    String
  amount      Float
  description String?
  date        DateTime
  createdAt   DateTime @default(now())

  @@index([businessId, date])
}

// Paquete de sesiones prepagadas de un servicio (ej. "5 cortes por $80.000"),
// definido por el dueño. `ClientPackagePurchase` es lo que un cliente
// concreto compró de ese paquete, con el saldo que le va quedando.
model ServicePackage {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id])
  name         String
  sessionCount Int
  price        Float
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  purchases ClientPackagePurchase[]
}

model ClientPackagePurchase {
  id                String         @id @default(cuid())
  businessId        String
  business          Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId          String
  client            Client         @relation(fields: [clientId], references: [id])
  servicePackageId  String
  servicePackage    ServicePackage @relation(fields: [servicePackageId], references: [id])
  sessionsRemaining Int
  purchasedAt       DateTime       @default(now())
  expiresAt         DateTime?

  appointments Appointment[]

  @@index([clientId, servicePackageId])
}

// Producto físico que el negocio vende además de sus servicios (ej. shampoo,
// cera, cremas). No participa en el flujo de reserva de citas — es solo
// catálogo/venta directa en el local.
model Product {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  imageUrl    String?
  price       Float
  stock       Int? // null = no se trackea inventario para este producto
  minStock    Int? // null = sin alerta de stock bajo
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  sales ProductSale[]
}

// Venta puntual de un producto (no participa del flujo de citas). Descuenta
// stock si el producto lo trackea, y alimenta el esperado de caja cuando el
// pago fue en efectivo.
model ProductSale {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  quantity      Int
  unitPrice     Float
  total         Float
  paymentMethod String // CASH, CARD_IN_PERSON
  soldByUserId  String
  soldBy        User     @relation(fields: [soldByUserId], references: [id])
  receiptNumber Int? // consecutivo de factura/recibo, asignado al vender
  giftCardCode     String? // código de la tarjeta de regalo usada, si hubo
  giftCardRedeemed Float? // cuánto del total se cubrió con tarjeta de regalo
  createdAt     DateTime @default(now())

  @@index([businessId, createdAt])
}

// "Tiendita": inventario aparte del Catálogo para mecatos, bebidas, galletas —
// solo existe para negocios con Business.storeEnabled = true (lo activa
// Soporte, no todas las barberías venden esto).
model StoreItem {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  category    String? // texto libre: Bebidas, Snacks, Galletas, Dulces...
  description String?
  imageUrl    String?
  costPrice   Float? // cuánto costó comprarlo; null = no se trackea margen
  price       Float // precio de venta
  stock       Int? // null = no se trackea inventario para este producto
  minStock    Int? // null = sin alerta de stock bajo
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  sales    StoreSale[]
  restocks StoreRestock[]

  @@index([businessId, category])
}

// Venta puntual de un producto de la Tiendita. Descuenta stock si el producto
// lo trackea, y alimenta el esperado de caja cuando el pago fue en efectivo.
model StoreSale {
  id            String    @id @default(cuid())
  storeItemId   String
  storeItem     StoreItem @relation(fields: [storeItemId], references: [id], onDelete: Cascade)
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  quantity      Int
  unitPrice     Float
  unitCost      Float? // snapshot del costo al momento de vender, para que el margen histórico no cambie si luego se edita el costo
  total         Float
  paymentMethod String // CASH, CARD_IN_PERSON
  soldByUserId  String
  soldBy        User      @relation(fields: [soldByUserId], references: [id])
  receiptNumber Int? // consecutivo de factura/recibo, asignado al vender
  giftCardCode     String? // código de la tarjeta de regalo usada, si hubo
  giftCardRedeemed Float? // cuánto del total se cubrió con tarjeta de regalo
  createdAt     DateTime  @default(now())

  @@index([businessId, createdAt])
}

// Reabastecimiento de un producto de la Tiendita — a diferencia de solo
// editar el número de stock, esto deja un historial de cuándo y cuánto
// entró, y a qué costo.
model StoreRestock {
  id                String    @id @default(cuid())
  storeItemId       String
  storeItem         StoreItem @relation(fields: [storeItemId], references: [id], onDelete: Cascade)
  businessId        String
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  quantity          Int // cuánto se agregó al stock
  costPrice         Float? // costo unitario de este lote (puede variar en el tiempo)
  note              String?
  restockedByUserId String
  restockedBy       User      @relation(fields: [restockedByUserId], references: [id])
  createdAt         DateTime  @default(now())

  @@index([businessId, createdAt])
}

// Tarjeta de regalo — se emite en persona desde el panel o el cliente la
// compra online (pago manual, mismo patrón que el anticipo de citas). Solo
// existe para negocios con Business.giftCardsEnabled = true (lo activa
// Soporte). El saldo se redime contra citas, Catálogo o Tiendita — el
// "historial de uso" se reconstruye consultando esas tablas por `code`, no
// hay un modelo de redención aparte.
model GiftCard {
  id             String    @id @default(cuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code           String    @unique // 8 caracteres, alfabeto sin 0/O/1/I para leerlo por WhatsApp sin confusión
  initialAmount  Float
  balance        Float // saldo restante; se descuenta al redimir
  recipientName  String?
  recipientPhone String?
  purchaserName  String?
  purchaserPhone String?
  purchaserEmail String?
  expiresAt      DateTime?
  status         String    @default("ACTIVE") // PENDING_PAYMENT (compra online sin confirmar), ACTIVE, CANCELLED
  paymentMethod  String? // CASH, CARD_IN_PERSON, TRANSFER
  issuedByUserId String?
  issuedBy       User?     @relation(fields: [issuedByUserId], references: [id])
  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?

  @@index([businessId, status])
}

model Appointment {
  id                String      @id @default(cuid())
  businessId        String
  business          Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffId           String
  staff             Staff       @relation(fields: [staffId], references: [id])
  serviceId         String
  service           Service     @relation(fields: [serviceId], references: [id])
  clientId          String
  client            Client      @relation(fields: [clientId], references: [id])
  clientName        String
  clientPhone       String
  clientEmail       String?
  startTime         DateTime
  endTime           DateTime
  status            String      @default("CONFIRMED") // CONFIRMED, CANCELLED, COMPLETED, NO_SHOW, PENDING_PAYMENT
  source            String      @default("ONLINE") // ONLINE, WALK_IN
  anyStaffRequested Boolean     @default(false)
  lateCancellation  Boolean     @default(false)
  priceCharged      Float? // snapshot del precio total del servicio al momento de la reserva
  depositAmount     Float? // cuánto se exigió/cobró como anticipo (seña); null = esta cita nunca tuvo anticipo
  // Cuándo y quién confirmó el comprobante del anticipo (transferencia) — campo
  // aparte de paidAt/paymentMethod porque esos se sobrescriben después, al
  // cobrar el saldo en persona. Sirve para atribuir esa transferencia a la
  // caja de quien la confirmó, aunque la cita ya haya quedado pagada del todo.
  depositConfirmedAt       DateTime?
  depositConfirmedByUserId String?
  depositConfirmedBy       User?    @relation("AppointmentDepositConfirmedBy", fields: [depositConfirmedByUserId], references: [id])
  giftCardCode      String? // código de la tarjeta de regalo usada, si hubo
  giftCardRedeemed  Float? // cuánto del precio se cubrió con tarjeta de regalo
  paymentMethod     String      @default("UNPAID") // UNPAID, CASH, CARD_IN_PERSON, ONLINE, TRANSFER
  paymentStatus     String      @default("PENDING") // PENDING, PARTIALLY_PAID (solo el anticipo), PAID, REFUNDED, AWAITING_VERIFICATION
  paidAt            DateTime? // cuándo se marcó como pagada (para acotar sesiones de caja) — con anticipo, se actualiza al cobrar el saldo
  receiptNumber     Int? // consecutivo de factura/recibo, asignado al marcar como pagada
  refundedAt        DateTime?
  refundReason      String?
  refundedByUserId  String? // quién procesó el reembolso, para atribuirlo a su caja (si fue en efectivo)
  refundedBy        User?    @relation("AppointmentRefundedBy", fields: [refundedByUserId], references: [id])
  reminderSentAt    DateTime? // evita mandar el mismo recordatorio dos veces
  paymentReminderSentAt DateTime? // evita repetir el aviso de "confirma tu pago pronto" antes de expirar
  recurrenceGroupId String? // comparte id entre todas las citas de una misma serie recurrente; null = cita suelta
  couponCode        String? // cupón aplicado al reservar, si hubo
  packagePurchaseId String? // si esta cita consumió una sesión de un paquete prepagado
  packagePurchase   ClientPackagePurchase? @relation(fields: [packagePurchaseId], references: [id])
  createdAt         DateTime    @default(now())
  review            Review?

  @@index([staffId, startTime])
  @@index([businessId, startTime])
  @@index([businessId, recurrenceGroupId])
}

// Reseña que un cliente deja después de una cita completada.
model Review {
  id            String      @id @default(cuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])
  staffId       String?
  staff         Staff?      @relation(fields: [staffId], references: [id])
  rating        Int // 1 a 5
  comment       String?
  createdAt     DateTime    @default(now())
}

// Sesión de caja: apertura y cierre de un turno, por empleado o general
// (staffId null). Se calcula lo esperado (efectivo cobrado en la ventana de
// la sesión) contra lo contado físicamente, y la diferencia queda guardada
// para siempre — no solo mientras la caja está abierta.
model CashSession {
  id             String    @id @default(cuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffId        String?
  staff          Staff?    @relation(fields: [staffId], references: [id])
  openedByUserId String
  openedBy       User      @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id])
  closedByUserId String?
  closedBy       User?     @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id])
  openingAmount  Float     @default(0)
  countedAmount  Float?
  expectedAmount Float?
  difference     Float?
  cardAmount     Float? // total en tarjeta en persona durante la ventana: confiado del sistema, no se cuenta a ciegas
  transferAmount Float? // total en transferencias confirmadas (anticipos, tarjetas de regalo online) atribuidas a esta caja: igual de confiado, no se cuenta a ciegas
  notes          String?
  status         String    @default("OPEN") // OPEN, CLOSED
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  movements      CashMovement[]

  @@index([businessId, status])
}

// Movimiento manual de efectivo dentro de una caja abierta, sin venta de por
// medio (sacar cambio, meter una base extra, un préstamo, etc.) — siempre
// con un concepto obligatorio, mismo espíritu que las notas de un cierre que
// no cuadra: ningún movimiento de dinero se hace en silencio.
model CashMovement {
  id              String      @id @default(cuid())
  cashSessionId   String
  cashSession     CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  type            String // INGRESO, EGRESO
  amount          Float
  concept         String
  createdByUserId String
  createdBy       User        @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime    @default(now())

  @@index([cashSessionId])
}

// Cierre congelado de un período de nómina/comisión para un miembro del
// personal: evita recalcular (y pagar dos veces) el mismo rango de fechas.
model PayrollPayout {
  id                String   @id @default(cuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffId           String
  staff             Staff    @relation(fields: [staffId], references: [id])
  periodStart       DateTime
  periodEnd         DateTime
  revenue           Float
  commissionPercent Int?
  commissionAmount  Float
  paidByUserId      String
  paidBy            User     @relation(fields: [paidByUserId], references: [id])
  createdAt         DateTime @default(now())

  @@index([businessId, staffId, periodStart])
}

// Cliente que quiere avisarse si se libera un horario en un día que ya no
// tenía cupo. notifiedAt marca que ya se le avisó (para no repetir el aviso).
model WaitlistEntry {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service   @relation(fields: [serviceId], references: [id])
  staffId     String?
  staff       Staff?    @relation(fields: [staffId], references: [id])
  day         String // YYYY-MM-DD
  clientName  String
  clientPhone String
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([businessId, day])
}

// Cuenta interna de Soporte (el equipo que crea, activa/desactiva y da
// soporte a las empresas clientes). Deliberadamente separada de User: no
// pertenece a ninguna Organization/Business, tiene su propia sesión, y no
// hay registro público — se crea por bootstrap en el seed.
model SupportUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// Historial trazable de pagos de suscripción, registrado por Soporte —
// complementa (no reemplaza) el campo de notas libres de Business.
model SubscriptionInvoice {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amount         Float
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime @default(now())
  notes          String?
  recordedByName String // snapshot de qué cuenta de soporte lo registró, igual que AuditLog.userName
  createdAt      DateTime @default(now())

  @@index([businessId, createdAt])
}

// Bitácora de acciones sensibles (dinero y accesos) — no instrumenta todo el
// sistema a propósito, solo lo que de verdad importa auditar.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String? // null = acción interna de Soporte sin una empresa asociada (ej. gestión del equipo de soporte)
  businessId     String?
  userId         String?
  userName       String // snapshot: sigue siendo legible si el usuario se borra/desactiva
  action         String
  details        String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}
