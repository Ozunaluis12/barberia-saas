DATABASE_URL="postgresql://usuario:password@host:5432/basededatos"
SESSION_SECRET="genera-una-cadena-larga-y-aleatoria-aqui"
# Opcional: sin esto, los correos (recuperar contraseña, recordatorios) solo se
# imprimen en la consola en vez de enviarse de verdad. Se consigue en resend.com.
RESEND_API_KEY=""
# Opcional: remitente de los correos transaccionales. Sin esto, salen desde el
# dominio de pruebas de Resend (onboarding@resend.dev) en vez del tuyo propio.
RESEND_FROM_ADDRESS="Turnify <soporte@tudominio.com>"
# Crea (o actualiza) la primera cuenta del panel interno /soporte cuando corres
# `npm run seed` — sin estas dos, el seed no crea ninguna cuenta de soporte y
# /soporte/login queda sin ninguna cuenta con la que entrar.
SUPPORT_EMAIL=""
SUPPORT_PASSWORD=""
# Opcional: sin esto, los recordatorios de WhatsApp solo se imprimen en la
# consola. Se consiguen en la consola de Twilio (twilio.com).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
# Opcional: sin esto, las fotos de personal/servicios/productos no se suben
# (el formulario funciona igual, solo no guarda imagen). Se consiguen en el
# dashboard de cloudinary.com.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
